---
import { WA_FALLBACK_URL } from '../config.js';

const packages = [
  {
    name: 'Orientación',
    price: '250',
    freq: '1 sesión + plan',
    desc: '"Dime qué hacer, yo me organizo solo."',
    features: ['1 sesión mensual', 'Plan nutricional personalizado', 'Sin seguimiento continuo'],
  },
  {
    name: 'Impulso',
    price: '320',
    freq: '1 sesión + plan + seguimiento mensual WSP',
    desc: '"Quiero empezar con estructura y saber que hay alguien."',
    features: ['1 sesión mensual', 'Plan nutricional personalizado', 'Seguimiento mensual por WhatsApp'],
  },
  {
    name: 'Estándar',
    price: '420',
    freq: '1 sesión + plan + seguimiento quincenal',
    desc: '"Necesito revisiones cada dos semanas."',
    features: ['1 sesión mensual', 'Plan nutricional personalizado', 'Revisión quincenal', 'Ajuste según tu avance'],
    highlight: true,
  },
  {
    name: 'Intensivo',
    price: '520',
    freq: '2 sesiones + plan + seguimiento frecuente',
    desc: '"Esta vez va en serio. Necesito contacto constante."',
    features: ['2 sesiones mensuales', 'Plan nutricional personalizado', 'Seguimiento frecuente', 'Soporte entre sesiones'],
  },
  {
    name: 'Premium',
    price: '680',
    freq: '4 sesiones + plan + seguimiento semanal',
    desc: '"Quiero a mi nutricionista de cabecera, cada semana."',
    features: ['4 sesiones mensuales', 'Plan nutricional personalizado', 'Seguimiento semanal', 'Acceso directo prioritario'],
  },
];
---

<section id="section-packages" class="section bg-white" aria-label="Paquetes de nutrición">
  <div class="container">
    <p class="label">Elige tu nivel de acompañamiento</p>
    <h2 class="title" style="margin-bottom: 0.75rem;">
      El paquete que encaja<br />con tu vida y tu objetivo.
    </h2>
    <p class="subtitle" style="margin-bottom: 3rem;">
      La diferencia entre paquetes es la frecuencia de contacto con tu nutricionista.
      Todos incluyen plan personalizado y seguimiento por WhatsApp.
      Si aún no sabes cuál elegir, más abajo hay una opción para ti.
    </p>

    <div class="packages-grid">
      {packages.map(pkg => (
        <article class={`pkg-card${pkg.highlight ? ' pkg-card--featured' : ''}`}>
          {pkg.highlight && <span class="pkg-badge">Más popular</span>}
          <h3 class="pkg-name">{pkg.name}</h3>
          <div class="pkg-price">
            <span class="pkg-price__amount">S/ {pkg.price}</span>
            <span class="pkg-price__period"> / mes</span>
          </div>
          <p class="pkg-freq">{pkg.freq}</p>
          <p class="pkg-desc">{pkg.desc}</p>
          <ul class="pkg-features">
            {pkg.features.map(f => (
              <li class="pkg-feature">
                <span aria-hidden="true">✓</span> {f}
              </li>
            ))}
          </ul>
          <a
            href={WA_FALLBACK_URL}
            class={`pkg-cta${pkg.highlight ? ' pkg-cta--featured' : ''}`}
            data-wa-section="paquetes"
            data-wa-pkg={pkg.name}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Quiero el paquete ${pkg.name} — abre WhatsApp`}
          >
            Quiero este paquete →
          </a>
        </article>
      ))}
    </div>

    <div class="packages-note">
      <p>
        ¿No sabes cuál elegir? No hay problema.
        Más abajo encontrarás la <strong>Evaluación Nutricional de S/80</strong> —
        una consulta previa que te ayuda a definir el paquete correcto para tu caso.
      </p>
    </div>
  </div>
</section>

<style>
.bg-white { background: var(--white); }

.packages-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
  margin-bottom: 3rem;
  align-items: start;
}

.pkg-card {
  border: 1px solid #e5e5e5;
  border-radius: 10px;
  padding: 1.5rem 1.25rem;
  position: relative;
  transition: border-color var(--transition), box-shadow var(--transition);
}

.pkg-card:hover {
  border-color: var(--gold);
  box-shadow: 0 4px 20px rgba(212,168,67,0.1);
}

.pkg-card--featured {
  border-color: var(--gold);
  background: var(--black);
}

.pkg-badge {
  display: inline-block;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--black);
  background: var(--gold);
  padding: 0.2rem 0.6rem;
  border-radius: 20px;
  margin-bottom: 0.75rem;
}

.pkg-name {
  font-size: 1.05rem;
  font-weight: 900;
  color: var(--black);
  margin-bottom: 0.625rem;
  letter-spacing: -0.2px;
}

.pkg-card--featured .pkg-name { color: var(--white); }

.pkg-price {
  margin-bottom: 0.25rem;
}

.pkg-price__amount {
  font-size: 1.5rem;
  font-weight: 900;
  color: var(--gold);
  letter-spacing: -0.5px;
}

.pkg-price__period {
  font-size: 0.8rem;
  color: var(--gray-mid);
}

.pkg-freq {
  font-size: 0.72rem;
  color: var(--gray-mid);
  margin-bottom: 0.875rem;
  letter-spacing: 0.3px;
}

.pkg-card--featured .pkg-freq { color: #888; }

.pkg-desc {
  font-size: 0.82rem;
  color: var(--gray-dark);
  line-height: 1.55;
  margin-bottom: 1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #eeeeee;
}

.pkg-card--featured .pkg-desc { color: #aaa; border-color: #222; }

.pkg-features {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.pkg-feature {
  font-size: 0.8rem;
  color: var(--gray-dark);
  display: flex;
  gap: 0.5rem;
  align-items: flex-start;
  line-height: 1.4;
}

.pkg-feature span { color: var(--gold); flex-shrink: 0; }
.pkg-card--featured .pkg-feature { color: #ccc; }

/* CTA por paquete */
.pkg-cta {
  display: block;
  margin-top: 1.25rem;
  padding: 0.75rem 1rem;
  background: var(--gray-light);
  color: var(--black);
  font-weight: 700;
  font-size: 0.82rem;
  text-align: center;
  border-radius: var(--radius);
  transition: background var(--transition), color var(--transition);
  min-height: 44px;
  line-height: 1.4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pkg-cta:hover { background: var(--gold); color: var(--black); }

.pkg-cta--featured {
  background: var(--gold);
  color: var(--black);
}

.pkg-cta--featured:hover { background: var(--gold-dark); }

/* Nota inferior */
.packages-note {
  margin-top: 2rem;
  padding: 1.5rem 2rem;
  background: var(--gray-light);
  border-radius: 10px;
  text-align: center;
}

.packages-note p {
  font-size: 0.92rem;
  color: var(--gray-dark);
  line-height: 1.65;
}

@media (max-width: 1100px) {
  .packages-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 700px) {
  .packages-grid { grid-template-columns: 1fr; }
}
</style>
