---
import { WA_FALLBACK_URL } from '../config.js';

const packages = [
  {
    name: 'Orientación',
    price: '250',
    freq: '1 consulta / mes',
    desc: 'Para quienes quieren empezar a ordenar su alimentación con acompañamiento básico mensual.',
    features: ['1 consulta mensual', 'Plan inicial personalizado', 'Canal de consultas por WhatsApp'],
  },
  {
    name: 'Impulso',
    price: '320',
    freq: '2 consultas / mes',
    desc: 'Mayor frecuencia de seguimiento para quienes necesitan ajustes más regulares.',
    features: ['2 consultas mensuales', 'Seguimiento quincenal', 'Ajuste de plan mensual'],
  },
  {
    name: 'Estándar',
    price: '420',
    freq: '4 consultas / mes',
    desc: 'El formato más popular. Consultas semanales con seguimiento continuo.',
    features: ['4 consultas mensuales', 'Revisión semanal', 'Ajuste según tu avance real', 'Soporte entre consultas'],
    highlight: true,
  },
  {
    name: 'Intensivo',
    price: '520',
    freq: '4 consultas + seguimiento semanal',
    desc: 'Para contextos exigentes que requieren acompañamiento más cercano y frecuente.',
    features: ['4 consultas mensuales', 'Seguimiento semanal detallado', 'Análisis de composición corporal', 'Prioridad de agenda'],
  },
  {
    name: 'Premium',
    price: '680',
    freq: 'Acceso continuo',
    desc: 'Acompañamiento máximo para quienes buscan el mayor nivel de personalización y soporte.',
    features: ['Consultas ilimitadas', 'Soporte directo continuo', 'Sesiones de coaching conductual', 'Análisis avanzado mensual', 'Prioridad absoluta de agenda'],
  },
];
---

<section id="section-packages" class="section bg-white">
  <div class="container">
    <p class="label">Paquetes</p>
    <h2 class="title" style="margin-bottom: 0.75rem;">
      El paquete se elige<br />después de la Evaluación.
    </h2>
    <p class="subtitle" style="margin-bottom: 3rem;">
      No elijas un paquete sin diagnóstico previo. La Evaluación de S/80 determina
      cuál es el nivel de acompañamiento que tu caso necesita.
    </p>

    <div class="packages-grid">
      {packages.map(pkg => (
        <article class={`pkg-card${pkg.highlight ? ' pkg-card--featured' : ''}`}>
          {pkg.highlight && <span class="pkg-badge">Más popular</span>}
          <h3 class="pkg-name">{pkg.name}</h3>
          <div class="pkg-price">
            <span class="pkg-price__amount">S/ {pkg.price}</span>
            <span class="pkg-price__period"> / mes</span>
          </div>
          <p class="pkg-freq">{pkg.freq}</p>
          <p class="pkg-desc">{pkg.desc}</p>
          <ul class="pkg-features">
            {pkg.features.map(f => (
              <li class="pkg-feature">
                <span aria-hidden="true">✓</span> {f}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="packages-cta">
      <p class="packages-cta__text">
        El primer paso siempre es la <strong>Evaluación Nutricional de S/80</strong>.<br />
        Desde ahí, Rodrigo te guía al paquete correcto para tu caso.
      </p>
      <a
        href={WA_FALLBACK_URL}
        class="btn-primary"
        data-wa-section="paquetes"
        target="_blank"
        rel="noopener noreferrer"
      >
        Comenzar con la Evaluación →
      </a>
    </div>
  </div>
</section>

<style>
.bg-white { background: var(--white); }

.packages-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
  margin-bottom: 3rem;
  align-items: start;
}

.pkg-card {
  border: 1px solid #e5e5e5;
  border-radius: 10px;
  padding: 1.5rem 1.25rem;
  position: relative;
  transition: border-color var(--transition), box-shadow var(--transition);
}

.pkg-card:hover {
  border-color: var(--gold);
  box-shadow: 0 4px 20px rgba(212,168,67,0.1);
}

.pkg-card--featured {
  border-color: var(--gold);
  background: var(--black);
}

.pkg-badge {
  display: inline-block;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--black);
  background: var(--gold);
  padding: 0.2rem 0.6rem;
  border-radius: 20px;
  margin-bottom: 0.75rem;
}

.pkg-name {
  font-size: 1.05rem;
  font-weight: 900;
  color: var(--black);
  margin-bottom: 0.625rem;
  letter-spacing: -0.2px;
}

.pkg-card--featured .pkg-name { color: var(--white); }

.pkg-price {
  margin-bottom: 0.25rem;
}

.pkg-price__amount {
  font-size: 1.5rem;
  font-weight: 900;
  color: var(--gold);
  letter-spacing: -0.5px;
}

.pkg-price__period {
  font-size: 0.8rem;
  color: var(--gray-mid);
}

.pkg-freq {
  font-size: 0.72rem;
  color: var(--gray-mid);
  margin-bottom: 0.875rem;
  letter-spacing: 0.3px;
}

.pkg-card--featured .pkg-freq { color: #888; }

.pkg-desc {
  font-size: 0.82rem;
  color: var(--gray-dark);
  line-height: 1.55;
  margin-bottom: 1rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid #eeeeee;
}

.pkg-card--featured .pkg-desc { color: #aaa; border-color: #222; }

.pkg-features {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.pkg-feature {
  font-size: 0.8rem;
  color: var(--gray-dark);
  display: flex;
  gap: 0.5rem;
  align-items: flex-start;
  line-height: 1.4;
}

.pkg-feature span { color: var(--gold); flex-shrink: 0; }
.pkg-card--featured .pkg-feature { color: #ccc; }

/* Section CTA */
.packages-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  text-align: center;
  padding: 2.5rem;
  background: var(--gray-light);
  border-radius: 12px;
}

.packages-cta__text {
  font-size: 1rem;
  color: var(--gray-dark);
  line-height: 1.65;
}

@media (max-width: 1100px) {
  .packages-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 700px) {
  .packages-grid { grid-template-columns: 1fr; }
}
</style>
